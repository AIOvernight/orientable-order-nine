theorem certificateNode6_192 : CheckFrom certificate [0,1,2,3,3,0] 4 3 = true := by
  refine checkFrom_step certificate [0,1,2,3,3,0] 4 2 ?_
  intro x hx
  have hxlt := List.mem_range.mp hx
  have cases : x = 0 ∨ x = 1 ∨ x = 2 ∨ x = 3 ∨ x = 4 := by omega
  rcases cases with rfl | rfl | rfl | rfl | rfl
  · exact certificateNode7_814
